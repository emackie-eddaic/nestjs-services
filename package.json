{
  "author": "Eric Mackie <eric.mackie@essolutions.ca>",
  "description": "Monorepo for a variety of NestJS services for easy configuration in NestJS",
  "engines": {
    "node": ">=24.9"
  },
  "license": "ISC",
  "name": "nestjs-services",
  "private": true,
  "version": "1.0.0",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@nestjs/axios": "^12.0.1",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/swagger": "^12.0.3",
    "@nestjs/testing": "^12.2.0",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.51.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "packages",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "*/src/**/*.ts",
      "!*/src/**/*.spec.ts",
      "!*/src/**/*.d.ts",
      "!*/src/**/index.ts",
      "!*/src/type/**"
    ],
    "coverageDirectory": "../coverage",
    "coverageReporters": [
      "html",
      "text",
      "text-summary",
      "cobertura"
    ],
    "testEnvironment": "node"
  },
  "scripts": {
    "build": "tsc --build",
    "format": "prettier --write \"packages/**/*.ts\"",
    "lint": "eslint \"packages/**/*.ts\"",
    "lint:fix": "eslint \"packages/**/*.ts\" --fix",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:packages": "node scripts/check-packages.mjs",
    "check": "npm run build && npm run lint && npm run test:cov -- --runInBand --watchman=false && npm run test:packages"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "commonjs"
}
